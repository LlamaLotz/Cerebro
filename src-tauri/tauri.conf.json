{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "cerebro",
  "version": "1.0.0",
  "identifier": "com.cerebro.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run web",
    "beforeBuildCommand": "npm run build-frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Cerebro",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../Extractor Final/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
